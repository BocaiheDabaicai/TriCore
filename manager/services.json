{
  "probe_interval": 5,
  "probe_timeout": 2,
  "startup_timeout": 30,
  "max_restarts": 5,
  "services": [
    {
      "name": "kb-agent",
      "port": 8000,
      "cwd": "kb-agent",
      "command": "{python} -m uvicorn main:app --port 8000",
      "auto_start": true
    },
    {
      "name": "ai-assistant",
      "port": 8001,
      "cwd": "ai-assistant",
      "command": "{python} -m uvicorn main:app --port 8001",
      "auto_start": true
    }
  ]
}
