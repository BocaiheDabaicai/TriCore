{
  "probe_interval": 5,
  "probe_timeout": 2,
  "startup_timeout": 30,
  "max_restarts": 5,
  "services": [
    {
      "name": "kb-agent",
      "port": 8000,
      "cwd": "kb-agent",
      "command": "{python} -m uvicorn main:app --port 8000",
      "probe_path": "/docs",
      "auto_start": true
    },
    {
      "name": "ai-assistant",
      "port": 8001,
      "cwd": "ai-assistant",
      "command": "{python} -m uvicorn main:app --port 8001",
      "probe_path": "/docs",
      "auto_start": true
    },
    {
      "name": "frontend",
      "port": 5173,
      "cwd": "ai-assistant/frontend",
      "command": "{npm} run dev",
      "probe_path": "/",
      "auto_start": true
    },
    {
      "name": "admin-frontend",
      "port": 5174,
      "cwd": "ai-assistant/admin-frontend",
      "command": "{npm} run dev",
      "probe_path": "/",
      "auto_start": true
    }
  ]
}
