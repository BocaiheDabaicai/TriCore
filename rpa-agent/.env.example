# 办公自动化执行器配置 —— 复制成 .env 后按需填写

# 金蝶网址（网页版入口）。不填也能用：打开浏览器后在窗口里自己输网址登录
KINGDEE_URL=

# OA 网址（将来"从 OA 取加点数据"要用）
OA_URL=

# 用哪个浏览器：
#   msedge / chrome —— 用系统已装的（免下载，推荐）
#   留空           —— 用 Playwright 自带的 chromium（首次要执行 playwright install chromium，约百兆）
BROWSER_CHANNEL=msedge

# 页面操作的默认等待上限（毫秒）：等不到就报错并截图留现场，而不是无限挂着
PAGE_TIMEOUT_MS=15000
